# MySQL用 .tbls.yml設定例

name: "MySQLプロジェクト"
desc: "MySQLデータベーススキーマドキュメント"

# MySQL接続設定
dsn:
  url: "mysql://username:password@localhost:3306/database_name?charset=utf8mb4&parseTime=true"

# MySQL特有のコメント設定
comment:
  separator: "|"  # MySQLのCOMMENT構文用

markdown:
  tables:
    show_logical_name: true
    order: ["name", "logical_name", "comment", "type", "engine"]
    aliases:
      name: "テーブル名"
      logical_name: "論理名"
      comment: "説明"
      type: "種別"
      engine: "ストレージエンジン"

  columns:
    show_logical_name: true
    order: ["name", "logical_name", "type", "nullable", "default", "auto_increment", "comment"]
    aliases:
      name: "カラム名"
      logical_name: "論理名"
      type: "データ型"
      nullable: "NULL許可"
      default: "デフォルト値"
      auto_increment: "自動増分"
      comment: "説明"

# MySQL向けER図設定
er:
  format: "svg"
  comment: true

# MySQL特有のオブジェクト除外
exclude:
  - "mysql.*"              # MySQLシステムデータベース
  - "information_schema.*"
  - "performance_schema.*"
  - "sys.*"

# MySQL特有のLint設定
lint:
  require:
    columnComment:
      enabled: true
      exclude: ["id", "created_at", "updated_at"]
    tableComment:
      enabled: true
  columnType:
    # MySQL推奨データ型チェック
    int:
      enabled: true
    varchar:
      enabled: true